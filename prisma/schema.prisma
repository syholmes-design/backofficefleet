  deletedAt  DateTime?
  thread     OperationalChatThread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tenant     Fleet                        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sender     User                         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  replyTo    OperationalChatMessage?      @relation("OperationalChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies    OperationalChatMessage[]     @relation("OperationalChatMessageReplies")
  reads      OperationalChatMessageRead[]

  @@index([threadId, createdAt])
  @@index([tenantId, visibility, createdAt])
}

model OperationalChatMessageRead {
  id        String                 @id @default(cuid())
  messageId String
  tenantId  String
  userId    String
  readAt    DateTime               @default(now())
  message   OperationalChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  tenant    Fleet                  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([tenantId, userId, readAt])
}

model OperationalChatCitation {
  id         String                    @id @default(cuid())
  threadId   String
  tenantId   String
  recordType OperationalChatRecordType
  recordId   String
  title      String
  snapshot   Json?
  route      String?
  createdAt  DateTime                  @default(now())
  thread     OperationalChatThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
  tenant     Fleet                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, recordType, recordId])
  @@index([threadId, createdAt])
}

model OperationalChatNotification {
  id        String    @id @default(cuid())
  tenantId  String
  userId    String
  threadId  String
  messageId String?
  kind      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  tenant    Fleet     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt, createdAt])
  @@index([threadId, createdAt])
}

model RegulatorySource {
  id                 String                  @id @default(cuid())
  sourceType         RegulatorySourceType
  agency             String
  title              String
  sourceUrl          String
  externalIdentifier String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  requirements       RegulatoryRequirement[]

  @@index([sourceType, agency])
}

model RegulatoryRequirement {
  id         String                         @id @default(cuid())
  sourceId   String
  stableKey  String                         @unique
  title      String
  topic      String
  cfrPart    String?
  section    String?
  subsection String?
  createdAt  DateTime                       @default(now())
  updatedAt  DateTime                       @updatedAt
  source     RegulatorySource               @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  versions   RegulatoryRequirementVersion[]

  @@index([sourceId, topic])
}

model RegulatoryRequirementVersion {
  id              String                    @id @default(cuid())
  requirementId   String
  citation        String
  summary         String
  publicationDate DateTime?
  effectiveDate   DateTime?
  endDate         DateTime?
  version         String
  status          RegulatoryRecordStatus
  sourceUrl       String
  retrievedAt     DateTime                  @default(now())
  createdAt       DateTime                  @default(now())
  requirement     RegulatoryRequirement     @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  trainingLinks   RegulatoryTrainingLink[]
  applicability   RegulatoryApplicability[]
  assignments     TrainingAssignment[]

  @@unique([requirementId, version])
  @@index([citation, effectiveDate])
  @@index([status, effectiveDate])
}

model RegulatoryApplicability {
  id                   String                        @id @default(cuid())
  fleetId              String
  driverId             String?
  requirementVersionId String
  status               RegulatoryApplicabilityStatus @default(NOT_REVIEWED)
  rationale            String?
  determinedByUserId   String?
  determinedAt         DateTime?
  expiresAt            DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  fleet                Fleet                         @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  driver               Driver?                       @relation(fields: [driverId], references: [id], onDelete: Restrict)
  requirementVersion   RegulatoryRequirementVersion  @relation(fields: [requirementVersionId], references: [id], onDelete: Restrict)
  determinedBy         User?                         @relation("RegulatoryApplicabilityDeterminedBy", fields: [determinedByUserId], references: [id], onDelete: SetNull)

  @@unique([fleetId, driverId, requirementVersionId])
  @@index([fleetId, status])
  @@index([requirementVersionId, status])
}

model TrainingModule {
  id                String                   @id @default(cuid())
  ownership         TrainingOwnership
  title             String
  category          String
  description       String
  audience          String
  keywords          String[]
  learningObjective String?
  resourceUrl       String
  resourceLabel     String
  required          Boolean                  @default(false)
  version           String
  effectiveDate     DateTime
  retiredAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  segments          TrainingSegment[]
  regulatoryLinks   RegulatoryTrainingLink[]
  assignments       TrainingAssignment[]

  @@index([category, ownership])
}

model TrainingSegment {
  id               String                   @id @default(cuid())
  trainingModuleId String
  title            String
  summary          String
  chapter          String?
  startSeconds     Int?
  endSeconds       Int?
  sourceLocator    String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  trainingModule   TrainingModule           @relation(fields: [trainingModuleId], references: [id], onDelete: Cascade)
  regulatoryLinks  RegulatoryTrainingLink[]

  @@index([trainingModuleId, chapter])
}

model RegulatoryTrainingLink {
  id                   String                       @id @default(cuid())
  requirementVersionId String
  trainingModuleId     String
  trainingSegmentId    String?
  isPrimary            Boolean                      @default(false)
  coverage             String?
  createdAt            DateTime                     @default(now())
  requirementVersion   RegulatoryRequirementVersion @relation(fields: [requirementVersionId], references: [id], onDelete: Cascade)
  trainingModule       TrainingModule               @relation(fields: [trainingModuleId], references: [id], onDelete: Cascade)
  trainingSegment      TrainingSegment?             @relation(fields: [trainingSegmentId], references: [id], onDelete: SetNull)

  @@unique([requirementVersionId, trainingModuleId, trainingSegmentId])
  @@index([trainingModuleId, isPrimary])
}

model TrainingAssignment {
  id                   String                        @id @default(cuid())
  fleetId              String
  driverId             String
  trainingModuleId     String
  requirementVersionId String?
  applicabilityId      String?
  assignedByUserId     String
  assignedAt           DateTime                      @default(now())
  dueAt                DateTime?
  status               TrainingAssignmentStatus      @default(ASSIGNED)
  reason               String?
  startedAt            DateTime?
  viewedAt             DateTime?
  knowledgeCheckStatus String?
  completedAt          DateTime?
  acknowledgedAt       DateTime?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt
  fleet                Fleet                         @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  driver               Driver                        @relation(fields: [driverId], references: [id], onDelete: Restrict)
  trainingModule       TrainingModule                @relation(fields: [trainingModuleId], references: [id], onDelete: Restrict)
  requirementVersion   RegulatoryRequirementVersion? @relation(fields: [requirementVersionId], references: [id], onDelete: Restrict)
  assignedBy           User                          @relation("TrainingAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  certification        TrainingCertification?

  @@index([fleetId, status, dueAt])
  @@index([driverId, status])
  @@index([trainingModuleId, requirementVersionId])
}

model TrainingCertification {
  id            String                       @id @default(cuid())
  assignmentId  String                       @unique
  fleetId       String
  driverId      String
  outcome       TrainingCertificationOutcome
  certifiedById String?
  certifiedAt   DateTime                     @default(now())
  expiresAt     DateTime?
  notes         String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  assignment    TrainingAssignment           @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  fleet         Fleet                        @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  driver        Driver                       @relation(fields: [driverId], references: [id], onDelete: Restrict)
  certifiedBy   User?                        @relation("TrainingCertificationIssuedBy", fields: [certifiedById], references: [id], onDelete: SetNull)

  @@index([fleetId, outcome, certifiedAt])
  @@index([driverId, outcome])
}
