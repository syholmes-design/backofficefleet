generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum FleetStatus {
  ACTIVE
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INVITED
  INACTIVE
}

enum AggregatorStatus {
  ACTIVE
  ARCHIVED
}

enum CarrierGroupStatus {
  ACTIVE
  ARCHIVED
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum DriverIntakeSource {
  EMAIL
  PORTAL
  MOBILE
  UPLOAD
  API
  MANUAL
}

enum DriverIntakeChannel {
  WEB
  MOBILE
  API
  UPLOAD
  INTERNAL_ADMIN
}

enum DriverIntakeStageType {
  NEW
  IDENTITY_REVIEW
  DOCUMENT_COLLECTION
  QUALIFICATION_REVIEW
  COMPLIANCE_REVIEW
  READY_FOR_APPROVAL
  APPROVED
  REJECTED
}

enum DriverIntakeStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  NEEDS_ATTENTION
  READY_FOR_APPROVAL
  APPROVED
  REJECTED
  ARCHIVED
}

enum DriverDocumentType {
  DRIVER_LICENSE
  MEDICAL
  DRUG_TEST
  WORK_HISTORY
  ACCIDENT_HISTORY
  VIOLATION_HISTORY
  IDENTITY_SUPPORTING
  OTHER
}

enum DriverDocumentStatus {
  RECEIVED
  PENDING_VERIFICATION
  VERIFIED
  CERTIFIED
  REJECTED
  EXPIRED
}

enum VerificationStatus {
  RECEIVED
  PENDING_VERIFICATION
  VERIFIED
  CERTIFIED
  REJECTED
}

enum RequirementStatus {
  REQUIRED
  PENDING
  SATISFIED
  REJECTED
  EXPIRED
  EXCEPTION
}

enum QualificationStatus {
  ACTIVE
  PENDING
  REVIEW_REQUIRED
  EXPIRED
  REJECTED
}

enum QualificationDisposition {
  QUALIFIED
  CONDITIONALLY_QUALIFIED
  NOT_QUALIFIED
  PENDING_REVIEW
}

enum DriverReadinessState {
  READY
  CONDITIONAL
  NOT_READY
}

enum EmployerDocumentMaterializationStorageMode {
  COPY
  REFERENCE
}

enum LoadStatus {
  PLANNED
  ASSIGNED
  DISPATCHED
  IN_TRANSIT
  DELIVERED
  EXCEPTION
}

enum EquipmentType {
  TRACTOR
  TRAILER
}

enum EquipmentStatus {
  AVAILABLE
  UNAVAILABLE
  OUT_OF_SERVICE
}

enum DispatchAssignmentStatus {
  ACTIVE
  SUPERSEDED
  COMPLETED
  CANCELLED
}

enum PreTripStatus {
  OPEN
  COMPLETED
  BLOCKED
  VOIDED
}

enum PreTripItemStatus {
  PENDING
  PASS
  WARNING
  FAIL
  NOT_APPLICABLE
}

enum PreTripDefectSeverity {
  WARNING
  BLOCKING
}

enum DispatchReleaseDisposition {
  RELEASED
  CONDITIONALLY_RELEASED
  HOLD
  BLOCKED
}

enum ConditionCategory {
  MECHANICAL
  ELECTRICAL
  STRUCTURAL
  SAFETY
  CARGO
  SECUREMENT
  COSMETIC
  DOCUMENTATION
  OTHER
}

enum ConditionSeverity {
  MINOR
  MODERATE
  CRITICAL
  BLOCKING
}

enum ConditionImpact {
  COSMETIC_ONLY
  SAFETY_RISK
  LOAD_RISK
  DELAY_RISK
  REGULATORY_RISK
  CUSTOMER_RISK
}

enum ConditionObservationSource {
  DRIVER
  MAINTENANCE
  SAFETY
  DISPATCH
  SYSTEM
  TELEMATICS
  AI_ASSISTED
  OTHER
}

enum ConditionVerificationState {
  UNVERIFIED
  CONFIRMED
  VERIFIED
}

enum ConditionLifecycleState {
  IDENTIFIED
  CONFIRMED
  CHANGED
  REPAIR_REPORTED
  AWAITING_VERIFICATION
  RESOLVED
  REOPENED
}

enum ConditionEventType {
  IDENTIFIED
  CONFIRMED
  CHANGED
  REPAIR_REPORTED
  AWAITING_VERIFICATION
  RESOLUTION_VERIFIED
  REOPENED
}

enum ConditionResolutionAuthority {
  DRIVER
  FLEET_MAINTENANCE
  THIRD_PARTY_SHOP
  SAFETY
  DISPATCH
  OTHER_AUTHORIZED_ACTOR
}

enum ConditionEvidenceCompleteness {
  NONE
  PARTIAL
  COMPLETE
  INSUFFICIENT
}

enum ConditionEvidenceKind {
  PHOTO
  VIDEO
  DOCUMENT
  SYSTEM_VALUE
  NOTE
}

enum AuditAction {
  CREATED
  UPDATED
  DELETED
  LOGIN
  LOGOUT
  ROLE_ASSIGNED
  ROLE_REMOVED
  ACCESS_GRANTED
  ACCESS_DENIED
  VIEWED
  IMPORTED
  EXPORTED
}

enum OperationalChatThreadType {
  LOAD_THREAD
  EXCEPTION_THREAD
  DOCUMENT_THREAD
  DRIVER_THREAD
  CUSTOMER_THREAD
  SETTLEMENT_THREAD
  SAFETY_COMPLIANCE_THREAD
  MAINTENANCE_THREAD
  GENERAL_INTERNAL_THREAD
}

enum OperationalChatVisibility {
  INTERNAL
  CUSTOMER_VISIBLE
}

enum OperationalChatStatus {
  OPEN
  WAITING
  RESOLVED
}

enum OperationalChatMessageState {
  SENT
  DELIVERED
  READ
}

enum OperationalChatParticipantRole {
  FLEET_OWNER
  FLEET_MANAGER
  DISPATCH
  DRIVER
  SAFETY
  FINANCE
  BOF_OPERATIONS
  BOF_ADMINISTRATION
  CUSTOMER
}

enum OperationalChatRecordType {
  LOAD
  DRIVER
  EXCEPTION
  DOCUMENT_REQUEST
  PROOF
  SETTLEMENT
  SAFETY_EVENT
  COMPLIANCE_ISSUE
  MAINTENANCE_ISSUE
  CARRIER
  CUSTOMER
  REGULATION
  TRAINING_MODULE
  TRAINING_ASSIGNMENT
  TRAINING_CERTIFICATION
}

enum RegulatorySourceType {
  REGULATION
  FMCSA_GUIDANCE
  FEDERAL_REGISTER
  FMCSA_TRAINING
  BOF_TRAINING
  BOF_POLICY
}

enum RegulatoryRecordStatus {
  CURRENT
  SUPERSEDED
  PROPOSED
  ARCHIVED
}

enum RegulatoryApplicabilityStatus {
  NOT_REVIEWED
  APPLICABLE
  NOT_APPLICABLE
  CONDITIONAL
  REVIEW_REQUIRED
}

enum TrainingOwnership {
  BOF_INTERNAL
  FMCSA_OFFICIAL
}

enum TrainingAssignmentStatus {
  ASSIGNED
  STARTED
  VIEWED
  KNOWLEDGE_CHECK
  PASSED
  ACKNOWLEDGED
  CERTIFIED
  COMPLETE
  REVIEW_REQUIRED
  OVERDUE
  CANCELLED
}

enum TrainingCertificationOutcome {
  CERTIFIED
  NOT_CERTIFIED
  EXPIRED
  REQUIRES_REVIEW
}

model Fleet {
  id                               String                            @id @default(cuid())
  slug                             String                            @unique
  name                             String
  carrierGroupId                   String
  status                           FleetStatus                       @default(ACTIVE)
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  carrierGroup                     CarrierGroup                      @relation(fields: [carrierGroupId], references: [id], onDelete: Restrict)
  memberships                      FleetMembership[]
  drivers                          Driver[]
  driverIntakes                    DriverIntake[]
  driverDocuments                  DriverDocument[]
  documentAuthorizations           DocumentAuthorization[]
  employerDocumentMaterializations EmployerDocumentMaterialization[]
  auditEvents                      AuditEvent[]
  aggregatorFleets                 AggregatorFleet[]
  qualificationSnapshots           DriverQualificationSnapshot[]
  readinessScores                  DriverReadinessScore[]
  driverClaimTokens                DriverClaimToken[]
  loads                            Load[]
  equipment                        Equipment[]
  dispatchAssignments              DispatchAssignment[]
  preTripHeaders                   PreTripHeader[]
  dispatchReleases                 DispatchRelease[]
  conditionThreads                 ConditionThread[]                 @relation("ConditionThreadFleet")
  conditionEvents                  ConditionEvent[]                  @relation("ConditionEventFleet")
  operationalEvidence              OperationalEvidence[]             @relation("OperationalEvidenceFleet")
  operationalChatThreads           OperationalChatThread[]
  operationalChatMessages          OperationalChatMessage[]
  operationalChatCitations         OperationalChatCitation[]
  operationalChatNotifications     OperationalChatNotification[]
  operationalChatParticipants      OperationalChatParticipant[]
  operationalChatMessageReads      OperationalChatMessageRead[]
  regulatoryApplicabilities        RegulatoryApplicability[]
  trainingAssignments              TrainingAssignment[]
  trainingCertifications           TrainingCertification[]

  @@index([status])
  @@index([carrierGroupId, status])
}

model User {
  id                                  String                            @id @default(cuid())
  email                               String                            @unique
  name                                String?
  passwordHash                        String?
  image                               String?
  status                              UserStatus                        @default(ACTIVE)
  createdAt                           DateTime                          @default(now())
  updatedAt                           DateTime                          @updatedAt
  memberships                         FleetMembership[]
  aggregatorMemberships               AggregatorMembership[]
  accounts                            Account[]
  sessions                            Session[]
  auditEvents                         AuditEvent[]
  driverIntakesCreated                DriverIntake[]                    @relation("DriverIntakeCreatedBy")
  driverIntakesApproved               DriverIntake[]                    @relation("DriverIntakeApprovedBy")
  driverIntakesRejected               DriverIntake[]                    @relation("DriverIntakeRejectedBy")
  driverIntakesCertified              DriverIntake[]                    @relation("DriverIntakeCertifiedBy")
  driverIntakeStagesChanged           DriverIntakeStage[]               @relation("DriverIntakeStageChangedBy")
  driverDocumentsUploaded             DriverDocument[]                  @relation("DriverDocumentUploadedBy")
  driverDocumentsVerified             DriverDocument[]                  @relation("DriverDocumentVerifiedBy")
  driverDocumentsCertified            DriverDocument[]                  @relation("DriverDocumentCertifiedBy")
  documentAuthorizationsCreated       DocumentAuthorization[]           @relation("DocumentAuthorizationAuthorizedBy")
  documentAuthorizationsRevoked       DocumentAuthorization[]           @relation("DocumentAuthorizationRevokedBy")
  employerDocumentMaterializations    EmployerDocumentMaterialization[] @relation("EmployerDocumentMaterializedBy")
  verificationSources                 VerificationSource[]              @relation("VerificationSourceVerifiedBy")
  qualificationSnapshots              DriverQualificationSnapshot[]     @relation("DriverQualificationSnapshotEvaluatedBy")
  readinessScores                     DriverReadinessScore[]            @relation("DriverReadinessScoreEvaluatedBy")
  dispatchAssignmentsAssigned         DispatchAssignment[]              @relation("DispatchAssignmentAssignedBy")
  dispatchAssignmentsUnassigned       DispatchAssignment[]              @relation("DispatchAssignmentUnassignedBy")
  completedPreTrips                   PreTripHeader[]                   @relation("PreTripHeaderCompletedBy")
  dispatchReleasesEvaluated           DispatchRelease[]                 @relation("DispatchReleaseEvaluatedBy")
  driver                              Driver?
  driverClaimTokensCreated            DriverClaimToken[]                @relation("DriverClaimTokenCreatedBy")
  conditionThreadsCreated             ConditionThread[]                 @relation("ConditionThreadCreatedByUser")
  conditionEventsRecorded             ConditionEvent[]                  @relation("ConditionEventRecordedByUser")
  operationalEvidenceCaptured         OperationalEvidence[]             @relation("OperationalEvidenceCapturedByUser")
  operationalChatThreadsCreated       OperationalChatThread[]           @relation("OperationalChatThreadCreatedBy")
  operationalChatThreadsOwned         OperationalChatThread[]           @relation("OperationalChatThreadOwner")
  operationalChatParticipants         OperationalChatParticipant[]
  operationalChatMessages             OperationalChatMessage[]
  operationalChatMessageReads         OperationalChatMessageRead[]
  operationalChatNotifications        OperationalChatNotification[]
  regulatoryApplicabilitiesDetermined RegulatoryApplicability[]         @relation("RegulatoryApplicabilityDeterminedBy")
  trainingAssignmentsAssigned         TrainingAssignment[]              @relation("TrainingAssignmentAssignedBy")
  trainingCertificationsIssued        TrainingCertification[]           @relation("TrainingCertificationIssuedBy")

  @@index([status])
}

model Role {
  id                    String                 @id @default(cuid())
  code                  String                 @unique
  name                  String
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  memberships           FleetMembership[]
  aggregatorMemberships AggregatorMembership[]
}

model Aggregator {
  id               String                 @id @default(cuid())
  name             String
  status           AggregatorStatus       @default(ACTIVE)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  carrierGroups    CarrierGroup[]
  memberships      AggregatorMembership[]
  aggregatorFleets AggregatorFleet[]

  @@index([status])
}

model CarrierGroup {
  id           String             @id @default(cuid())
  aggregatorId String
  name         String
  status       CarrierGroupStatus @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  aggregator   Aggregator         @relation(fields: [aggregatorId], references: [id], onDelete: Restrict)
  fleets       Fleet[]

  @@unique([aggregatorId, name])
  @@index([aggregatorId, status])
}

model AggregatorFleet {
  id           String           @id @default(cuid())
  aggregatorId String
  fleetId      String
  status       MembershipStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  aggregator   Aggregator       @relation(fields: [aggregatorId], references: [id], onDelete: Cascade)
  fleet        Fleet            @relation(fields: [fleetId], references: [id], onDelete: Cascade)

  @@unique([aggregatorId, fleetId])
  @@index([aggregatorId, status])
  @@index([fleetId, status])
}

model AggregatorMembership {
  id           String           @id @default(cuid())
  userId       String
  aggregatorId String
  roleId       String
  status       MembershipStatus @default(ACTIVE)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  aggregator   Aggregator       @relation(fields: [aggregatorId], references: [id], onDelete: Cascade)
  role         Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, aggregatorId])
  @@index([aggregatorId, status])
  @@index([userId, status])
}

model FleetMembership {
  id        String           @id @default(cuid())
  userId    String
  fleetId   String
  roleId    String
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  fleet     Fleet            @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  role      Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([fleetId, userId])
  @@index([fleetId, status])
  @@index([userId, status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model DriverClaimToken {
  id              String    @id @default(cuid())
  driverId        String
  fleetId         String
  tokenHash       String    @unique
  expiresAt       DateTime
  createdByUserId String
  claimedAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  driver          Driver    @relation(fields: [driverId], references: [id], onDelete: Restrict)
  fleet           Fleet     @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  createdByUser   User      @relation("DriverClaimTokenCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([driverId])
  @@index([fleetId])
  @@index([createdByUserId])
  @@index([expiresAt])
}

model Driver {
  id                               String                            @id @default(cuid())
  userId                           String?                           @unique
  fleetId                          String
  firstName                        String
  lastName                         String
  email                            String
  phone                            String?
  dob                              DateTime?
  ssnLast4                         String?
  homeTerminalId                   String?
  status                           DriverStatus                      @default(ACTIVE)
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  user                             User?                             @relation(fields: [userId], references: [id], onDelete: SetNull)
  fleet                            Fleet                             @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  claimTokens                      DriverClaimToken[]
  driverIntakes                    DriverIntake[]
  driverDocuments                  DriverDocument[]
  documentAuthorizations           DocumentAuthorization[]
  employerDocumentMaterializations EmployerDocumentMaterialization[]
  licenses                         DriverLicense[]
  endorsements                     DriverEndorsement[]
  medicalQualifications            MedicalQualification[]
  drugTests                        DrugTestRecord[]
  workHistory                      WorkHistory[]
  accidentHistory                  AccidentHistory[]
  violationHistory                 ViolationHistory[]
  qualificationSnapshots           DriverQualificationSnapshot[]
  readinessScores                  DriverReadinessScore[]
  dispatchAssignments              DispatchAssignment[]
  dispatchReleases                 DispatchRelease[]
  conditionThreadsCreated          ConditionThread[]                 @relation("ConditionThreadCreatedByDriver")
  conditionEventsRecorded          ConditionEvent[]                  @relation("ConditionEventRecordedByDriver")
  operationalEvidenceCaptured      OperationalEvidence[]             @relation("OperationalEvidenceCapturedByDriver")
  regulatoryApplicabilities        RegulatoryApplicability[]
  trainingAssignments              TrainingAssignment[]
  trainingCertifications           TrainingCertification[]

  @@index([fleetId, status])
  @@index([email])
  @@index([phone])
}

model DriverIntake {
  id                           String                        @id @default(cuid())
  driverId                     String
  fleetId                      String
  createdByUserId              String
  intakeSource                 DriverIntakeSource            @default(PORTAL)
  intakeChannel                DriverIntakeChannel           @default(WEB)
  stage                        DriverIntakeStageType         @default(NEW)
  status                       DriverIntakeStatus            @default(DRAFT)
  submittedAt                  DateTime?
  approvedAt                   DateTime?
  approvedByUserId             String?
  rejectedAt                   DateTime?
  rejectedByUserId             String?
  isComplianceCertified        Boolean                       @default(false)
  complianceCertifiedAt        DateTime?
  complianceCertifiedByUserId  String?
  complianceCertificationNotes String?
  notes                        String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  driver                       Driver                        @relation(fields: [driverId], references: [id], onDelete: Restrict)
  fleet                        Fleet                         @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  createdByUser                User                          @relation("DriverIntakeCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedByUser               User?                         @relation("DriverIntakeApprovedBy", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  rejectedByUser               User?                         @relation("DriverIntakeRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: Restrict)
  complianceCertifiedByUser    User?                         @relation("DriverIntakeCertifiedBy", fields: [complianceCertifiedByUserId], references: [id], onDelete: Restrict)
  stageHistory                 DriverIntakeStage[]
  documents                    DriverDocument[]
  requirements                 DriverIntakeRequirement[]
  licenses                     DriverLicense[]               @relation("DriverIntakeLicense")
  endorsements                 DriverEndorsement[]           @relation("DriverIntakeEndorsement")
  medicalQualifications        MedicalQualification[]        @relation("DriverIntakeMedicalQualification")
  drugTests                    DrugTestRecord[]              @relation("DriverIntakeDrugTest")
  workHistory                  WorkHistory[]                 @relation("DriverIntakeWorkHistory")
  accidentHistory              AccidentHistory[]             @relation("DriverIntakeAccidentHistory")
  violationHistory             ViolationHistory[]            @relation("DriverIntakeViolationHistory")
  qualificationSnapshots       DriverQualificationSnapshot[]
  readinessScores              DriverReadinessScore[]

  @@index([fleetId, status])
  @@index([driverId, status])
  @@index([createdAt])
}

model DriverIntakeStage {
  id              String                @id @default(cuid())
  driverIntakeId  String
  stage           DriverIntakeStageType
  status          DriverIntakeStatus?
  changedByUserId String?
  notes           String?
  createdAt       DateTime              @default(now())
  driverIntake    DriverIntake          @relation(fields: [driverIntakeId], references: [id], onDelete: Cascade)
  changedByUser   User?                 @relation("DriverIntakeStageChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([driverIntakeId, createdAt])
}

model DriverDocument {
  id                               String                            @id @default(cuid())
  sourceDocumentId                 String                            @default(cuid())
  versionNumber                    Int                               @default(1)
  previousVersionId                String?
  supersededAt                     DateTime?
  supersededByDocumentId           String?
  driverId                         String
  driverIntakeId                   String
  fleetId                          String
  type                             DriverDocumentType
  status                           DriverDocumentStatus              @default(RECEIVED)
  storageKey                       String
  originalFileName                 String
  mimeType                         String?
  checksum                         String?
  uploadedByUserId                 String
  uploadedAt                       DateTime                          @default(now())
  verifiedByUserId                 String?
  verifiedAt                       DateTime?
  verifiedFromSourceAt             DateTime?
  certifiedAt                      DateTime?
  certifiedByUserId                String?
  verificationExpiresAt            DateTime?
  nextVerificationDueAt            DateTime?
  verificationQuality              String?
  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  driver                           Driver                            @relation(fields: [driverId], references: [id], onDelete: Restrict)
  driverIntake                     DriverIntake                      @relation(fields: [driverIntakeId], references: [id], onDelete: Restrict)
  fleet                            Fleet                             @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  previousVersion                  DriverDocument?                   @relation("DriverDocumentPreviousVersion", fields: [previousVersionId], references: [id], onDelete: Restrict)
  nextVersion                      DriverDocument?                   @relation("DriverDocumentPreviousVersion")
  supersededByDocument             DriverDocument?                   @relation("DriverDocumentSupersededBy", fields: [supersededByDocumentId], references: [id], onDelete: Restrict)
  supersedesDocument               DriverDocument?                   @relation("DriverDocumentSupersededBy")
  uploadedByUser                   User                              @relation("DriverDocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  verifiedByUser                   User?                             @relation("DriverDocumentVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: Restrict)
  certifiedByUser                  User?                             @relation("DriverDocumentCertifiedBy", fields: [certifiedByUserId], references: [id], onDelete: Restrict)
  documentAuthorizations           DocumentAuthorization[]           @relation("DocumentAuthorizationVersion")
  employerDocumentMaterializations EmployerDocumentMaterialization[] @relation("DriverDocumentMaterializationVersion")
  verificationSources              VerificationSource[]              @relation("VerificationSourceDriverDocument")
  requirementsSatisfied            DriverIntakeRequirement[]         @relation("RequirementSatisfiedByDocument")

  @@unique([sourceDocumentId, versionNumber])
  @@unique([previousVersionId])
  @@unique([supersededByDocumentId])
  @@index([sourceDocumentId])
  @@index([previousVersionId])
  @@index([supersededByDocumentId])
  @@index([driverId, type, status])
  @@index([fleetId, type])
  @@index([verifiedByUserId])
}

model DocumentAuthorization {
  id                  String                            @id @default(cuid())
  sourceDocumentId    String
  sourceVersionNumber Int
  driverId            String
  fleetId             String
  authorizedByUserId  String
  authorizedAt        DateTime                          @default(now())
  revokedAt           DateTime?
  revokedByUserId     String?
  createdAt           DateTime                          @default(now())
  sourceDocument      DriverDocument                    @relation("DocumentAuthorizationVersion", fields: [sourceDocumentId, sourceVersionNumber], references: [sourceDocumentId, versionNumber], onDelete: Restrict)
  driver              Driver                            @relation(fields: [driverId], references: [id], onDelete: Restrict)
  fleet               Fleet                             @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  authorizedByUser    User                              @relation("DocumentAuthorizationAuthorizedBy", fields: [authorizedByUserId], references: [id], onDelete: Restrict)
  revokedByUser       User?                             @relation("DocumentAuthorizationRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  materializations    EmployerDocumentMaterialization[]

  @@index([sourceDocumentId, sourceVersionNumber])
  @@index([sourceDocumentId, fleetId, sourceVersionNumber])
  @@index([driverId])
  @@index([fleetId])
  @@index([authorizedByUserId])
  @@index([authorizedAt])
  @@index([revokedAt])
}

model EmployerDocumentMaterialization {
  id                     String                                     @id @default(cuid())
  authorizationId        String                                     @unique
  sourceDocumentId       String
  sourceVersionNumber    Int
  driverId               String
  fleetId                String
  materializedByUserId   String
  materializedAt         DateTime                                   @default(now())
  storageMode            EmployerDocumentMaterializationStorageMode
  sourceStorageKey       String
  employerStorageKey     String?
  originalFileName       String
  mimeType               String?
  checksum               String?
  standardizedEntityType String?
  standardizedEntityId   String?
  createdAt              DateTime                                   @default(now())
  authorization          DocumentAuthorization                      @relation(fields: [authorizationId], references: [id], onDelete: Restrict)
  sourceDocument         DriverDocument                             @relation("DriverDocumentMaterializationVersion", fields: [sourceDocumentId, sourceVersionNumber], references: [sourceDocumentId, versionNumber], onDelete: Restrict)
  driver                 Driver                                     @relation(fields: [driverId], references: [id], onDelete: Restrict)
  fleet                  Fleet                                      @relation(fields: [fleetId], references: [id], onDelete: Restrict)
  materializedByUser     User                                       @relation("EmployerDocumentMaterializedBy", fields: [materializedByUserId], references: [id], onDelete: Restrict)

  @@index([authorizationId])
  @@index([sourceDocumentId, sourceVersionNumber])
  @@index([driverId, fleetId])
  @@index([materializedAt])
