+.bof-dispatch-polish section[id="route-control"] {
+  scroll-margin-top: 7rem;
+}
+
+@media (max-width: 700px) {
+  .bof-dispatch-polish > section:first-child .relative,
+  .bof-dispatch-polish > section:first-child .absolute {
+    min-height: auto;
+  }
+
+  .bof-dispatch-polish > section:first-child > div.relative {
+    padding-top: 2.6rem !important;
+    padding-bottom: 2.6rem !important;
+  }
+
+  .bof-dispatch-polish .sticky {
+    position: static !important;
+  }
+}
+
+.shipper-portal,
+.trip-release-page {
+  width: min(100%, 1160px);
+  max-width: 1160px;
+  margin-inline: auto;
+}
+
+.shipper-portal-card,
+.trip-release-card,
+.trip-release-side,
+.trip-release-banner {
+  box-shadow: 0 14px 36px rgba(2, 6, 23, 0.16);
+}
+
+.shipper-portal-actions a,
+.shipper-portal-button,
+.trip-release-actions a,
+.trip-release-btn {
+  min-height: 2.25rem;
+}
+
+@media (max-width: 640px) {
+  .shipper-portal,
+  .trip-release-page {
+    width: 100%;
+    padding-left: 1rem;
+    padding-right: 1rem;
+  }
+
+  .shipper-portal-card,
+  .trip-release-card,
+  .trip-release-side {
+    padding: 0.9rem;
+  }
+
+  .shipper-portal-actions,
+  .trip-release-actions,
+  .trip-release-footer {
+    gap: 0.45rem;
+  }
+
+  .trip-release-banner-row {
+    align-items: flex-start;
+  }
+
+  .trip-release-banner-counts {
+    width: 100%;
+  }
+}
