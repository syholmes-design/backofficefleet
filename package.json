{
  "name": "bof-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && node scripts/clear-next-cache.mjs && next build",
    "start": "next start",
    "lint": "npm run lint:eslint",
    "lint:next": "next lint",
    "lint:eslint": "eslint app components lib next.config.ts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "codex:bootstrap": "node scripts/codex-bootstrap.mjs",
    "codex:registry-sync": "node scripts/agent-registry-sync.mjs",
    "codex:before-demo": "node scripts/codex-before-demo.mjs",
    "codex:change-memory": "node scripts/save-change-memory.mjs",
    "codex:collision-check": "node scripts/check-change-collision.mjs",
    "audit:install-browsers": "npx --yes playwright install chromium",
    "audit:demo-clickability": "node scripts/audit-demo-clickability.mjs",
    "audit:demo-completeness": "node scripts/audit-demo-completeness.mjs",
    "audit:bof-links": "node scripts/audit-bof-links.mjs",
    "audit:visual-smoke": "node scripts/audit-visual-smoke.mjs",
    "build:data": "node scripts/build-demo-data.mjs",
    "seed:driver-templates-expanded": "node scripts/seed-driver-templates-expanded-xlsx.mjs",
    "merge:settlements": "node scripts/merge-payroll-settlements.mjs",
    "patch:dispatch": "node scripts/patch-dispatch-clean-columns.mjs",
    "build:loads": "node scripts/build-dispatch-loads.mjs",
    "generate:docs": "node scripts/generate-bof-documents.mjs",
    "generate:load-docs": "node scripts/generate-load-docs.mjs",
    "generate:load-evidence": "node scripts/generate-load-evidence.mjs",
    "generate:load-evidence:ai": "node scripts/generate-load-evidence.mjs --enable-ai",
    "generate:safety-evidence-svg": "node scripts/generate-safety-evidence-svg.mjs",
    "generate:demo-docs": "npm run generate:load-docs && npm run generate:load-evidence",
    "validate:load-docs": "node scripts/validate-load-docs.mjs",
    "validate:load-signatures": "node scripts/validate-load-signatures.mjs",
    "validate:load-doc-templates": "node scripts/validate-load-doc-templates.mjs",
    "validate:load-evidence": "node scripts/validate-load-evidence.mjs",
    "validate:load-trip-packets": "node scripts/validate-load-trip-packets.mjs",
    "validate:load-intake-routing": "node scripts/validate-load-intake-routing.mjs",
    "validate:safety-evidence": "node scripts/validate-safety-evidence.mjs",
    "sync:driver-hr-docs": "node scripts/sync-driver-hr-docs.mjs",
    "validate:driver-docs": "node scripts/validate-driver-docs.mjs",
    "validate:driver-medical-status": "node scripts/validate-driver-medical-status.mjs",
    "validate:driver-review-explanations": "node scripts/validate-driver-review-explanations.mjs",
    "validate:review-explanations": "npx --yes tsx scripts/validate-review-explanations.ts",
    "validate:driver-credential-source-alignment": "node scripts/validate-driver-credential-source-alignment.mjs",
    "validate:driver-blockers": "node scripts/validate-driver-blockers.mjs",
    "validate:driver-document-packets": "node scripts/validate-driver-document-packets.mjs",
    "validate:driver-dqf-readiness": "node scripts/validate-driver-dqf-readiness.mjs",
    "generate:driver-dqf-summaries": "node scripts/generate-driver-dqf-summaries.mjs",
    "validate:driver-dqf-summaries": "node scripts/validate-driver-dqf-summaries.mjs",
    "validate:safety-credential-mapping": "node scripts/validate-safety-credential-mapping.mjs",
    "generate:driver-hr-payroll-docs": "node scripts/generate-driver-hr-payroll-docs.mjs",
    "validate:driver-mvr-status": "node scripts/validate-driver-mvr-status.mjs",
    "validate:compliance-incident-reconciliation": "node scripts/validate-compliance-incident-reconciliation.mjs",
    "validate:driver-review-ux": "node scripts/validate-driver-review-ux.mjs",
    "validate:dashboard-attention-queue": "node scripts/validate-dashboard-attention-queue.mjs",
    "audit:actionability-links": "node scripts/audit-actionability-links.mjs",
    "generate:driver-docs": "node scripts/generate-driver-docs.mjs && node scripts/patch-medical-card-html-demo.mjs && npm run validate:driver-medical-status",
    "deploy:full": "npm run generate:driver-docs && git add . && (git commit -m \"Auto deploy: regenerate docs + sync\" || node -e \"process.exit(0)\") && git push && npx --yes vercel --prod",
    "demo:reset": "node scripts/reset-demo.mjs",
    "demo:reset:deploy": "npm run demo:reset && git add . && (git commit -m \"Demo reset\" || node -e \"process.exit(0)\") && git push && npx --yes vercel --prod"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.21",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.8.0",
    "mapbox-gl": "^3.23.0",
    "next": "^15.1.0",
    "next-auth": "^5.0.0-beta.32",
    "pdf-parse": "^2.4.5",
    "prisma": "^7.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.1.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "xlsx": "^0.18.5"
  }
}
