{
  "workflowSteps": [
    {
      "id": "intake",
      "label": "Intake document",
      "description": "Receive a driver, carrier, or load document into the BOF Vault intake queue."
    },
    {
      "id": "classify",
      "label": "Classify document type",
      "description": "Identify whether the file is a CDL, medical card, insurance certificate, rate confirmation, POD, or another controlled document."
    },
    {
      "id": "assign",
      "label": "Assign to person/entity",
      "description": "Match the document to the right driver, carrier, load, or settlement record before it affects readiness."
    },
    {
      "id": "effective-date",
      "label": "Extract effective date",
      "description": "Record the effective date when the document creates coverage, qualification, or operational authority."
    },
    {
      "id": "expiration-date",
      "label": "Extract expiration date",
      "description": "Record the expiration date or mark the document as non-expiring when appropriate."
    },
    {
      "id": "primary-secondary",
      "label": "Determine primary vs secondary",
      "description": "Separate controlling readiness documents from supporting evidence and settlement backup."
    },
    {
      "id": "required-fields",
      "label": "Check required fields",
      "description": "Compare the document against required field rules for its type."
    },
    {
      "id": "verification-source",
      "label": "Identify verification source",
      "description": "Assign the correct verification source, such as a licensing agency, FMCSA-style verifier, insurer, customer, carrier, or internal reviewer."
    },
    {
      "id": "compliance-status",
      "label": "Assign compliance status",
      "description": "Mark the document as ready, at risk, blocked, or needing review."
    },
    {
      "id": "human-review",
      "label": "Route exceptions to human review",
      "description": "Send missing fields, expired records, wrong-driver matches, and low-confidence documents to the right BOF reviewer."
    },
    {
      "id": "readiness",
      "label": "Update driver readiness",
      "description": "Update driver, carrier, load, settlement, or readiness status after review."
    }
  ],
