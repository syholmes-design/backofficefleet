<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/(customer-demo|interactive-demo)(/|$)" bof_hidden_demo_route=1
  Header set X-Robots-Tag "noindex, nofollow" env=bof_hidden_demo_route

  <FilesMatch "\.(html?|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
